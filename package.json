{
  "name": "smorf",
  "version": "1.0.0",
  "description": "Form library for SolidJS.",
  "keywords": [
    "forms",
    "solidjs",
    "solid",
    "typescript"
  ],
  "repository": "github:glzr-io/smorf",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "solid": "./dist/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles": "./dist/index.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "prettier": "@glzr/style-guide/prettier",
  "dependencies": {
    "@solid-primitives/map": "1.0.0-next.2",
    "@solid-primitives/set": "1.0.0-next.2",
    "type-fest": "4.26.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@glzr/style-guide": "1.1.0",
    "@solidjs/web": "2.0.0-rc.13",
    "prettier": "3.1.1",
    "solid-js": "2.0.0-rc.13",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "unplugin-solid": "3.0.0"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.13",
    "solid-js": "^2.0.0-rc.13"
  },
  "packageManager": "pnpm@9.4.0"
}
